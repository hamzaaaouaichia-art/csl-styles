<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US" page-range-format="minimal">
  <info>
    <title>Ferkhi Vancouver Custom</title>
    <title-short>Ferkhi Vancouver</title-short>
    <id>http://www.zotero.org/styles/ferkhi-vancouver-custom</id>
    <link href="http://www.zotero.org/styles/ferkhi-vancouver-custom" rel="self"/>
    <updated>2026-10-06T00:00:00+00:00</updated>
    <author>
      <name>Custom CSL style</name>
    </author>
    <category citation-format="numeric"/>
    <category field="engineering"/>
    <summary>Numeric Vancouver-style bibliography: [n] Authors. Title. Journal Year;Vol(Issue):pages.</summary>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " initialize-with="" initialize-hyphen="false" delimiter=", "/>
    </names>
  </macro>

  <citation collapse="citation-number">
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography second-field-align="flush">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <group delimiter=". ">
        <text macro="author"/>
        <text variable="title"/>
        <group delimiter=" ">
          <text variable="container-title" form="short"/>
          <group>
            <date variable="issued">
              <date-part name="year"/>
            </date>
            <group prefix=";">
              <text variable="volume"/>
              <text variable="issue" prefix="(" suffix=")"/>
              <text variable="page" prefix=":"/>
            </group>
          </group>
        </group>
      </group>
    </layout>
  </bibliography>
</style>
